{
  "name": "codealive",
  "displayName": "CodeAlive",
  "description": "See what code does and what changed: local JS/TS explanations, bounded replay, PR evidence and editable explanation videos.",
  "version": "1.0.4",
  "publisher": "codealive-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "code explanation",
    "typescript",
    "flow diagram",
    "pull requests",
    "sonification"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "CodeAlive",
      "properties": {
        "codealive.narration.engine": {
          "type": "string",
          "enum": ["system", "online", "tone"],
          "default": "system",
          "enumDescriptions": [
            "Speech generated on this machine with macOS say, espeak-ng or espeak. No text leaves the machine.",
            "Microsoft online neural voices through uvx edge-tts and ffmpeg. Caption text is sent to Microsoft's speech service and uvx may download edge-tts.",
            "A wordless placeholder tone with speech-like timing, for testing or when no voice is installed."
          ],
          "markdownDescription": "Voice engine for **Generate voice narration**. If the chosen engine is unavailable, generation stops with an explanation instead of switching engines. Run **CodeAlive: Check Voice Setup** to see what is installed."
        },
        "codealive.narration.onlineVoice": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "Use codealive.narration.engine set to \"online\" instead.",
          "markdownDescription": "Deprecated. Set `codealive.narration.engine` to `online`. When true and the engine is left at `system`, the online engine is used."
        }
      }
    },
    "commands": [
      {
        "command": "codealive.checkVoiceSetup",
        "title": "CodeAlive: Check Voice Setup"
      },
      {
        "command": "codealive.start",
        "title": "CodeAlive: Open CodeAlive",
        "icon": "$(code)"
      },
      {
        "command": "codealive.explain",
        "title": "CodeAlive: Explain Selected Code"
      },
      {
        "command": "codealive.openExplainer",
        "title": "CodeAlive: Open Explainer"
      },
      {
        "command": "codealive.explainChanges",
        "title": "CodeAlive: Explain Working Tree Changes"
      },
      {
        "command": "codealive.open",
        "title": "CodeAlive: Open Studio"
      },
      {
        "command": "codealive.selection",
        "title": "CodeAlive: Load Selection"
      },
      {
        "command": "codealive.file",
        "title": "CodeAlive: Load Active File"
      },
      {
        "command": "codealive.follow",
        "title": "CodeAlive: Toggle Follow Editor"
      },
      {
        "command": "codealive.reviewPR",
        "title": "CodeAlive: Review GitHub PR"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codealive.start",
          "when": "resourceLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact)$/ && !isInDiffEditor",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "codealive.explain",
          "when": "editorHasSelection",
          "group": "navigation"
        },
        {
          "command": "codealive.selection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "test": "node ../scripts/test.cjs",
    "package": "python3 package.py",
    "build": "node ../scripts/build-shared.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bvs1006/CodeAlive.git"
  },
  "bugs": {
    "url": "https://github.com/bvs1006/CodeAlive/issues"
  },
  "preview": true
}
