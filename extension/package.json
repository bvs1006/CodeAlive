{
  "name": "codealive",
  "displayName": "CodeAlive",
  "description": "Read-only GitHub PR and CI companion, plus code sonification and algorithm video studio.",
  "version": "0.5.0",
  "publisher": "codealive-local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pull requests",
    "ci",
    "code review",
    "sonification",
    "algorithm visualization"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codealive.open",
        "title": "CodeAlive: Open Studio"
      },
      {
        "command": "codealive.selection",
        "title": "CodeAlive: Load Selection"
      },
      {
        "command": "codealive.file",
        "title": "CodeAlive: Load Active File"
      },
      {
        "command": "codealive.follow",
        "title": "CodeAlive: Toggle Follow Editor"
      },
      {
        "command": "codealive.reviewPR",
        "title": "CodeAlive: Review GitHub PR"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codealive.selection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "test": "node test-extension.cjs",
    "package": "python3 package.py"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bvs1006/CodeAlive.git"
  },
  "bugs": {
    "url": "https://github.com/bvs1006/CodeAlive/issues"
  }
}
